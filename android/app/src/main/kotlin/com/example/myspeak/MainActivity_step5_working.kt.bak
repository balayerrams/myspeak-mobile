
package com.example.myspeak

import android.app.AlarmManager
import android.app.PendingIntent
import android.content.Context
import android.content.Intent
import android.os.Build
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity : FlutterActivity() {

    companion object {
        private const val CHANNEL = "com.example.myspeak/reminders"
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)

        MethodChannel(
            flutterEngine.dartExecutor.binaryMessenger,
            CHANNEL
        ).setMethodCallHandler { call, result ->

            when (call.method) {

                "checkScheduler" -> {
                    result.success("Android scheduling bridge connected")
                }

                "canScheduleExactAlarms" -> {
                    val alarmManager =
                        getSystemService(Context.ALARM_SERVICE) as AlarmManager

                    result.success(
                        alarmManager.canScheduleExactAlarms()
                    )
                }

                "scheduleTestAlarm" -> {
                    val alarmManager =
                        getSystemService(Context.ALARM_SERVICE) as AlarmManager

                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S &&
                        !alarmManager.canScheduleExactAlarms()
                    ) {
                        result.error(
                            "PERMISSION_DENIED",
                            "Exact alarm permission is not enabled",
                            null
                        )
                    } else {
                        try {
                            val intent = Intent(
                                this,
                                ReminderAlarmReceiver::class.java
                            ).apply {
                                putExtra(
                                    "message",
                                    "Time to take your medicine"
                                )
                            }

                            val pendingIntent = PendingIntent.getBroadcast(
                                this,
                                1001,
                                intent,
                                PendingIntent.FLAG_UPDATE_CURRENT or
                                    PendingIntent.FLAG_IMMUTABLE
                            )

                            val triggerTime =
                                System.currentTimeMillis() + 2 * 60 * 1000L

                            alarmManager.setExactAndAllowWhileIdle(
                                AlarmManager.RTC_WAKEUP,
                                triggerTime,
                                pendingIntent
                            )

                            result.success(
                                "Test alarm scheduled for 2 minutes from now"
                            )
                        } catch (e: SecurityException) {
                            result.error(
                                "ALARM_SECURITY_ERROR",
                                e.message,
                                null
                            )
                        }
                    }
                }

                else -> {
                    result.notImplemented()
                }
            }
        }
    }
}
